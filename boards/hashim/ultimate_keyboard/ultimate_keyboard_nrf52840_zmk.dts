/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    model = "Ultimate Keyboard";
    compatible = "hashim,ultimate-keyboard";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,battery = &vbatt;
        zmk,underglow = &led_strip;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <7>;
        map = <
            /* Row 0 - Function Row (16 keys: Esc, F1..F12, PrtSc, Pause, Del) */
            RC(0,  0) RC(0,  1) RC(0,  2) RC(0,  3) RC(0,  4) RC(0,  5) RC(0,  6) RC(0,  7) RC(0,  8) RC(0,  9) RC(0, 10) RC(0, 11) RC(1,  0) RC(1,  1) RC(1,  2) RC(1,  3)
            /* Row 1 - Number Row (15 keys: ~`, 1..0, -, =, Backspace, Home) */
            RC(1,  4) RC(1,  5) RC(1,  6) RC(1,  7) RC(1,  8) RC(1,  9) RC(1, 10) RC(1, 11) RC(2,  0) RC(2,  1) RC(2,  2) RC(2,  3) RC(2,  4) RC(2,  5) RC(2,  6)
            /* Row 2 - QWERTY Row (15 keys: Tab, Q..P, [, ], \, PgUp) */
            RC(2,  7) RC(2,  8) RC(2,  9) RC(2, 10) RC(2, 11) RC(3,  0) RC(3,  1) RC(3,  2) RC(3,  3) RC(3,  4) RC(3,  5) RC(3,  6) RC(3,  7) RC(3,  8) RC(3,  9)
            /* Row 3 - Home Row (14 keys: Caps, A..', Enter, PgDn) */
            RC(3, 10) RC(3, 11) RC(4,  0) RC(4,  1) RC(4,  2) RC(4,  3) RC(4,  4) RC(4,  5) RC(4,  6) RC(4,  7) RC(4,  8) RC(4,  9) RC(4, 10) RC(4, 11)
            /* Row 4 - Bottom Row (14 keys: LShift, Z../, RShift, Up, End) */
            RC(5,  0) RC(5,  1) RC(5,  2) RC(5,  3) RC(5,  4) RC(5,  5) RC(5,  6) RC(5,  7) RC(5,  8) RC(5,  9) RC(5, 10) RC(5, 11) RC(6,  0) RC(6,  1)
            /* Row 5 - Modifiers & Arrows (10 keys: LCtrl, LGUI, LAlt, Space, RAlt, Fn, RCtrl, Left, Down, Right) */
            RC(6,  2) RC(6,  3) RC(6,  4) RC(6,  5) RC(6,  6) RC(6,  7) RC(6,  8) RC(6,  9) RC(6, 10) RC(6, 11)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        col-gpios
            = <&gpio1 10 GPIO_ACTIVE_HIGH>  /* Col 1  (Pad 2)  */
            , <&gpio0  3 GPIO_ACTIVE_HIGH>  /* Col 2  (Pad 3)  */
            , <&gpio0 28 GPIO_ACTIVE_HIGH>  /* Col 3  (Pad 4)  */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>  /* Col 4  (Pad 6)  */
            , <&gpio0  2 GPIO_ACTIVE_HIGH>  /* Col 5  (Pad 7)  */
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  /* Col 6  (Pad 8)  */
            , <&gpio0 31 GPIO_ACTIVE_HIGH>  /* Col 7  (Pad 9)  */
            , <&gpio0 30 GPIO_ACTIVE_HIGH>  /* Col 8  (Pad 10) */
            , <&gpio0 26 GPIO_ACTIVE_HIGH>  /* Col 9  (Pad 12) */
            , <&gpio0  6 GPIO_ACTIVE_HIGH>  /* Col 10 (Pad 14) */
            , <&gpio0  8 GPIO_ACTIVE_HIGH>  /* Col 11 (Pad 16) */
            , <&gpio0 12 GPIO_ACTIVE_HIGH>  /* Col 12 (Pad 20) */
            ;

        row-gpios
            = <&gpio0  7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 1 (Pad 22) */
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 2 (Pad 43) NFC2 */
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 3 (Pad 41) NFC1 */
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 4 (Pad 40) */
            , <&gpio1  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 5 (Pad 38) */
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 6 (Pad 36) */
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row 7 (Pad 34) */
            ;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>; /* P0.04/AIN2 (Pad 18) */
        output-ohms = <2000000>;
        full-ohms = <(2000000 + 820000)>;
    };

    ext-power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>; /* P1.09 (Pad 17) controls Q2 gate */
        init-delay-ms = <50>;
    };
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&usbd {
    status = "okay";
};

&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 11)>; /* P1.11 (Pad 1) RGB LEDs */
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 11)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <84>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00001000>;
        };

        code_partition: partition@1000 {
            reg = <0x00001000 0x000d3000>;
        };

        storage_partition: partition@d4000 {
            reg = <0x000d4000 0x00020000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
