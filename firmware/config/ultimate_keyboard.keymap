#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#define DEFAULT 0
#define FN      1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
                /* Row 0 - Function Row (16 keys) */
                &kp ESC    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12    &kp PSCRN  &kp PAUSE_BREAK  &kp DEL
                /* Row 1 - Number Row (15 keys) */
                &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL  &kp BSPC   &kp HOME
                /* Row 2 - QWERTY Row (15 keys) */
                &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT   &kp BSLH   &kp PG_UP
                /* Row 3 - Home Row (14 keys) */
                &kp CLCK   &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp RET    &kp PG_DN
                /* Row 4 - Bottom Row (14 keys) */
                &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp UP     &kp END
                /* Row 5 - Modifiers & Arrows (10 keys) */
                &kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE &kp RALT  &mo FN    &kp RCTRL &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        fn_layer {
            display-name = "Function";
            bindings = <
                /* Row 0 - Audio Controls & Utilities */
                &trans     &trans          &trans          &trans          &trans          &trans          &trans           &trans           &trans           &trans           &trans     &trans    &trans     &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP
                /* Row 1 - Bluetooth Profiles (1-5) and Clear */
                &trans     &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans           &trans           &trans           &trans           &trans     &trans    &trans     &bt BT_CLR &trans
                /* Row 2 - Per-Key RGB Controls (Toggle, Effects, Hue, Sat, Bri) */
                &trans     &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_HUI &rgb_ug RGB_HUD &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &trans     &trans    &trans     &trans     &trans
                /* Row 3 - Extended Functions */
                &trans     &trans          &trans          &trans          &trans          &trans          &trans           &trans           &trans           &trans           &trans     &trans    &trans     &trans
                /* Row 4 - Flashing Bootloader, Reset & Media Prev/Next */
                &trans     &trans          &trans          &trans          &trans          &bootloader     &sys_reset       &trans           &trans           &trans           &trans     &trans    &kp C_PREV &kp C_NEXT
                /* Row 5 - Play/Pause & Modifiers */
                &trans     &trans          &trans          &kp C_PP        &trans          &trans          &trans           &trans           &trans           &trans
            >;
        };
    };
};
