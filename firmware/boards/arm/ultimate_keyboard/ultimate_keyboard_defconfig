# Architecture and SoC
CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_ARM_MPU=y
CONFIG_ARM_DWT=y

# 32.768 kHz external crystal (MicroCrystal CM9V-T1A present on schematic & PCB)
CONFIG_CLOCK_CONTROL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_20PPM=y

# Power Management & DC/DC converters
CONFIG_BOARD_ENABLE_DCDC=y
CONFIG_BOARD_ENABLE_DCDC_HV=y

# GPIO and Matrix Scanning
CONFIG_GPIO=y
CONFIG_ZMK_KSCAN_MATRIX_POLLING=n

# Output UF2 file for Adafruit nRF52 UF2 bootloader
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_USE_DT_CODE_PARTITION=y

# USB & Bluetooth
CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
CONFIG_BT=y
CONFIG_BT_CTLR=y
CONFIG_BT_SMP=y
CONFIG_BT_PERIPHERAL=y

# Retained Memory for Bootloader Mode
CONFIG_RETAINED_MEM=y
CONFIG_RETENTION=y
CONFIG_RETENTION_BOOT_MODE=y

# Settings persistence (Bluetooth pairing keys, layer status, etc.)
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_NVS=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y

# Hardware Stack Protection
CONFIG_HW_STACK_PROTECTION=y

# Battery Monitoring ADC
CONFIG_ADC=y

# RGB Backlighting Driver (SPI to WS2812/SK6812)
CONFIG_LED_STRIP=y
CONFIG_WS2812_STRIP=y
CONFIG_SPI=y
